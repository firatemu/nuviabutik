# Copy to .env and fill with real values (do NOT commit .env)

# Django (required in production when DEBUG=False)
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=nuviabutik.com,www.nuviabutik.com,localhost,127.0.0.1

# Database (required in production when DEBUG=False)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nuviabutik_db

# Optional local dev DB parts (only used when DEBUG=True and DATABASE_URL unset)
# DB_NAME=nuviabutik_db
# DB_USER=nuviabutik_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Redis (sessions/cache)
REDIS_URL=redis://127.0.0.1:6379/1
USE_REDIS_CACHE=True

# Security / proxy
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Optional extra hosts (comma-separated)
# ADDITIONAL_HOSTS=
