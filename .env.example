# Copy to .env and fill with real values (do NOT commit .env)
#
# Django
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=nuviabutik.com,www.nuviabutik.com,localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nuviabutik_db

# Redis (sessions/cache)
REDIS_URL=redis://localhost:6379/0

# Security / proxy
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# MCP credentials (used by .cursor/mcp.json via env vars)
GITHUB_PERSONAL_ACCESS_TOKEN=
SENTRY_AUTH_TOKEN=
DD_API_KEY=
DD_APP_KEY=

